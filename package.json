{
  "name": "desktop-pet",
  "version": "0.1.0",
  "private": true,
  "description": "Windows desktop pet — Live2D import + chat scaffold",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.node.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "eval:retrieval": "vitest run --config vitest.config.ts evals/run.retrieval.eval.test.ts",
    "eval:retrieval:real": "vitest run --config vitest.config.ts evals/run.retrieval.eval.test.ts",
    "eval:retrieval:kb": "vitest run --config vitest.config.ts evals/run.retrieval.kb.eval.test.ts",
    "eval:ann": "vitest run --config vitest.config.ts evals/run.ann.eval.test.ts",
    "gen:queries": "vitest run --config vitest.config.ts evals/retrieval/generateQueries.test.ts",
    "eval:judge": "vitest run --config vitest.config.ts evals/run.judge.eval.test.ts",
    "eval:judge:real": "vitest run --config vitest.config.ts evals/run.judge.eval.test.ts",
    "eval:faithfulness": "vitest run --config vitest.config.ts evals/run.faithfulness.eval.test.ts",
    "eval:faithfulness:real": "vitest run --config vitest.config.ts evals/run.faithfulness.eval.test.ts",
    "eval:faithfulness:kb": "vitest run --config vitest.config.ts evals/run.faithfulness.kb.eval.test.ts",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@langchain/core": "^1.2.3",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/openai": "^1.5.5",
    "@xenova/transformers": "^2.17.2",
    "onnxruntime-node": "^1.27.0",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "file:./stubs/sharp"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.desktoppet.app",
    "productName": "DesktopPet",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/onnxruntime-node/**/*",
      "**/node_modules/@xenova/transformers/**/*",
      "**/node_modules/onnxruntime-common/**/*"
    ],
    "extraResources": [
      {
        "from": "public/live2d",
        "to": "live2d",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "skills",
        "to": "skills",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "overrides": {
    "sharp": "file:./stubs/sharp"
  }
}
